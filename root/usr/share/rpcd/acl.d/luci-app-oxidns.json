{
	"luci-app-oxidns": {
		"description": "Grant access to the OxiDNS LuCI app",
		"read": {
			"ubus": {
				"luci.oxidns": [
					"status",
					"dns_integration_status",
					"core_progress",
					"config_read",
					"config_schema",
					"config_plugin_types",
					"settings_read",
					"logs_recent",
					"logs_path_read"
				]
			}
		},
		"write": {
			"cgi-io": [ "upload" ],
			"file": {
				"/tmp/oxidns-core-upload-*": [ "write" ]
			},
			"ubus": {
				"luci.oxidns": [
					"core_install",
					"core_reinstall",
					"core_update",
					"core_upload_install",
					"core_webui_install",
					"core_remove",
					"service_start",
					"service_stop",
					"service_restart",
					"service_enable",
					"service_disable",
					"dns_integration_enable",
					"dns_integration_disable",
					"config_validate",
					"config_save",
					"settings_save",
					"logs_path_save"
				]
			}
		}
	}
}
