{
	"version": 1,
	"description": "Normal-mode editing contract for OxiDNS plugins. Field paths are relative to the plugin instance args.",
	"plugins": {
		"forward": {
			"title": "Forward",
			"fields": [
				{ "path": [ "concurrent" ], "label": "Concurrent upstreams", "type": "integer", "min": 1, "max": 32, "default": 1 },
				{ "path": [ "response_selection" ], "label": "Response selection", "type": "enum", "values": [ "fastest", "balanced", "prefer_positive", "consensus" ], "default": "balanced" },
				{ "path": [ "short_circuit" ], "label": "Short circuit", "type": "boolean" }
			]
		},
		"cache": {
			"title": "Cache",
			"fields": [
				{ "path": [ "size" ], "label": "Cache size (entries)", "type": "integer", "min": 0, "default": 1024 },
				{ "path": [ "lazy_cache_ttl" ], "label": "Override TTL (seconds)", "type": "integer", "min": 0 },
				{ "path": [ "dump_file" ], "label": "Dump file", "type": "string" },
				{ "path": [ "dump_interval" ], "label": "Dump interval (seconds)", "type": "integer", "min": 0, "default": 600 },
				{ "path": [ "short_circuit" ], "label": "Short circuit", "type": "boolean" },
				{ "path": [ "cache_negative" ], "label": "Cache negative responses", "type": "boolean", "default": true },
				{ "path": [ "max_negative_ttl" ], "label": "Max negative TTL (seconds)", "type": "integer", "min": 0, "default": 300 },
				{ "path": [ "negative_ttl_without_soa" ], "label": "Negative TTL without SOA (seconds)", "type": "integer", "min": 0, "default": 60 },
				{ "path": [ "max_positive_ttl" ], "label": "Max positive TTL (seconds)", "type": "integer", "min": 0 },
				{ "path": [ "min_positive_ttl" ], "label": "Min positive TTL (seconds)", "type": "integer", "min": 0 },
				{ "path": [ "ecs_in_key" ], "label": "Include ECS in cache key", "type": "boolean" }
			]
		},
		"hosts": {
			"title": "Hosts",
			"fields": [
				{ "path": [ "entries" ], "label": "Hosts entries", "type": "string-list", "placeholder": "example.com 192.0.2.1" },
				{ "path": [ "files" ], "label": "Hosts files", "type": "string-list", "placeholder": "/etc/hosts" },
				{ "path": [ "short_circuit" ], "label": "Short circuit", "type": "boolean" }
			]
		},
		"black_hole": {
			"title": "Black Hole",
			"fields": [
				{ "path": [ "mode" ], "label": "Blocking mode", "type": "enum", "values": [ "nxdomain", "nodata", "null", "custom", "refused" ] },
				{ "path": [ "ips" ], "label": "Answer addresses", "type": "string-list", "placeholder": "0.0.0.0" },
				{ "path": [ "short_circuit" ], "label": "Short circuit", "type": "boolean" }
			]
		},
		"fallback": {
			"title": "Fallback",
			"fields": [
				{ "path": [ "primary" ], "label": "Primary executor", "type": "string", "required": true },
				{ "path": [ "secondary" ], "label": "Standby executor", "type": "string", "required": true },
				{ "path": [ "threshold" ], "label": "Slow threshold (ms)", "type": "integer", "min": 0, "default": 0 },
				{ "path": [ "always_standby" ], "label": "Always run standby", "type": "boolean" },
				{ "path": [ "short_circuit" ], "label": "Short circuit", "type": "boolean" }
			]
		},
		"ip_selector": {
			"title": "IP Selector",
			"fields": [
				{ "path": [ "selection_mode" ], "label": "Selection mode", "type": "enum", "values": [ "first_success", "best_within_budget", "background" ], "default": "first_success" },
				{ "path": [ "outbound" ], "label": "Outbound profile", "type": "string" },
				{ "path": [ "socks5" ], "label": "SOCKS5 proxy", "type": "string" },
				{ "path": [ "probe_methods" ], "label": "Probe methods", "type": "string-list", "placeholder": "tcp:443\ntcp:80", "default": [ "tcp:443", "tcp:80" ] },
				{ "path": [ "probe_stagger" ], "label": "Probe stagger (ms)", "type": "integer", "min": 0, "default": 200 },
				{ "path": [ "probe_timeout" ], "label": "Probe timeout (ms)", "type": "integer", "min": 1, "default": 600 },
				{ "path": [ "max_wait" ], "label": "Max wait (ms)", "type": "integer", "min": 1, "default": 1000 },
				{ "path": [ "top_n" ], "label": "Top N addresses", "type": "integer", "min": 0, "default": 1 },
				{ "path": [ "dnssec_policy" ], "label": "DNSSEC policy", "type": "enum", "values": [ "reorder_only", "skip" ], "default": "reorder_only" },
				{ "path": [ "max_parallel_probes" ], "label": "Max parallel probes", "type": "integer", "min": 1, "default": 256 },
				{ "path": [ "cache", "enabled" ], "label": "Enable probe cache", "type": "boolean", "default": true },
				{ "path": [ "cache", "size" ], "label": "Probe cache size", "type": "integer", "min": 0, "default": 4096 },
				{ "path": [ "cache", "ttl" ], "label": "Success TTL (seconds)", "type": "integer", "min": 0, "default": 3600 },
				{ "path": [ "cache", "failure_ttl" ], "label": "Failure TTL (seconds)", "type": "integer", "min": 0, "default": 60 }
			]
		},
		"prefer_ipv4": {
			"title": "Prefer IPv4",
			"fields": [
				{ "path": [ "probe_executor" ], "label": "Probe executor", "type": "string", "help": "Executor tag used for the internal preferred-address probe." },
				{ "path": [ "cache" ], "label": "Cache preferred state", "type": "boolean", "default": true },
				{ "path": [ "cache_ttl" ], "label": "Preferred state TTL (seconds)", "type": "integer", "min": 0, "default": 3600 }
			]
		},
		"prefer_ipv6": {
			"title": "Prefer IPv6",
			"fields": [
				{ "path": [ "probe_executor" ], "label": "Probe executor", "type": "string", "help": "Executor tag used for the internal preferred-address probe." },
				{ "path": [ "cache" ], "label": "Cache preferred state", "type": "boolean", "default": true },
				{ "path": [ "cache_ttl" ], "label": "Preferred state TTL (seconds)", "type": "integer", "min": 0, "default": 3600 }
			]
		},
		"learn_domain": {
			"title": "Learn Domain",
			"fields": [
				{ "path": [ "provider" ], "label": "Target dynamic domain set", "type": "string", "required": true },
				{ "path": [ "phase" ], "label": "Learning phase", "type": "enum", "values": [ "before", "after" ], "default": "after" },
				{ "path": [ "questions" ], "label": "Questions", "type": "enum", "values": [ "first", "all" ], "default": "first" },
				{ "path": [ "qtypes" ], "label": "Query types", "type": "string-list", "placeholder": "A\nAAAA", "default": [ "A", "AAAA" ] },
				{ "path": [ "success_only" ], "label": "Require success (NOERROR)", "type": "boolean", "default": true },
				{ "path": [ "answer_required" ], "label": "Require an answer", "type": "boolean", "default": true },
				{ "path": [ "rule_kind" ], "label": "Rule kind", "type": "enum", "values": [ "full", "domain" ], "default": "full" },
				{ "path": [ "async" ], "label": "Asynchronous", "type": "boolean", "default": true },
				{ "path": [ "error_mode" ], "label": "Error handling", "type": "enum", "values": [ "continue", "stop", "fail" ], "default": "continue" },
				{ "path": [ "timeout" ], "label": "Timeout", "type": "string", "placeholder": "1s", "default": "1s" }
			]
		},
		"query_recorder": {
			"title": "Query Recorder",
			"fields": [
				{ "path": [ "path" ], "label": "Database path", "type": "string", "placeholder": "/tmp/oxidns/query.db", "required": true },
				{ "path": [ "queue_size" ], "label": "Queue size", "type": "integer", "min": 1, "default": 8192 },
				{ "path": [ "batch_size" ], "label": "Batch size", "type": "integer", "min": 1, "default": 256 },
				{ "path": [ "flush_interval_ms" ], "label": "Flush interval (ms)", "type": "integer", "min": 1, "default": 200 },
				{ "path": [ "memory_tail" ], "label": "In-memory tail size", "type": "integer", "min": 0, "default": 1024 },
				{ "path": [ "retention_days" ], "label": "Retention days", "type": "integer", "min": 1, "default": 7 },
				{ "path": [ "cleanup_interval_hours" ], "label": "Cleanup interval (hours)", "type": "integer", "min": 1, "default": 1 },
				{ "path": [ "reader_concurrency" ], "label": "Reader concurrency", "type": "integer", "min": 1, "default": 2 }
			]
		},
		"reverse_lookup": {
			"title": "Reverse Lookup",
			"fields": [
				{ "path": [ "size" ], "label": "Cache size (entries)", "type": "integer", "min": 0, "default": 65535 },
				{ "path": [ "ttl" ], "label": "Mapping TTL (seconds)", "type": "integer", "min": 0, "default": 7200 },
				{ "path": [ "handle_ptr" ], "label": "Answer PTR from cache", "type": "boolean", "default": false }
			]
		},
		"query_summary": {
			"title": "Query Summary",
			"fields": [
				{ "path": [ "msg" ], "label": "Summary label", "type": "string", "help": "Extra label for the periodic summary." }
			]
		},
		"metrics_collector": {
			"title": "Metrics Collector",
			"fields": [
				{ "path": [ "name" ], "label": "Metrics namespace", "type": "string", "help": "Metrics are exposed through GET /api/metrics." }
			]
		},
		"debug_print": {
			"title": "Debug Print",
			"fields": [
				{ "path": [ "msg" ], "label": "Message", "type": "string", "placeholder": "debug print" }
			]
		},
		"sleep": {
			"title": "Sleep",
			"fields": [
				{ "path": [ "duration" ], "label": "Sleep duration (ms)", "type": "string", "placeholder": "100" }
			]
		},
		"ttl": {
			"title": "TTL",
			"fields": [
				{ "path": [ "fix" ], "label": "Fixed TTL (seconds)", "type": "integer", "min": 0 },
				{ "path": [ "min" ], "label": "Minimum TTL (seconds)", "type": "integer", "min": 0 },
				{ "path": [ "max" ], "label": "Maximum TTL (seconds)", "type": "integer", "min": 0 }
			]
		},
		"download": {
			"title": "Download",
			"fields": [
				{
					"path": [ "downloads" ],
					"label": "Downloads",
					"type": "object-list",
					"item_label": "Download",
					"fields": [
						{ "path": [ "url" ], "label": "URL", "type": "string", "required": true, "placeholder": "https://example.com/rules.txt" },
						{ "path": [ "dir" ], "label": "Target directory", "type": "string", "placeholder": "/etc/oxidns" },
						{ "path": [ "filename" ], "label": "File name", "type": "string" }
					]
				},
				{ "path": [ "timeout" ], "label": "Timeout", "type": "string", "placeholder": "30s" },
				{ "path": [ "insecure_skip_verify" ], "label": "Skip TLS verification", "type": "boolean", "help": "Disables certificate verification for these downloads." },
				{ "path": [ "outbound" ], "label": "Outbound profile", "type": "string" },
				{ "path": [ "socks5" ], "label": "SOCKS5 proxy", "type": "string" },
				{ "path": [ "startup_if_missing" ], "label": "Download at startup when missing", "type": "boolean", "default": true }
			]
		},
		"ipset": {
			"title": "IPSet",
			"fields": [
				{ "path": [ "set_name4" ], "label": "IPv4 set name", "type": "string", "placeholder": "oxidns_v4" },
				{ "path": [ "set_name6" ], "label": "IPv6 set name", "type": "string", "placeholder": "oxidns_v6" },
				{ "path": [ "mask4" ], "label": "IPv4 prefix length", "type": "integer", "min": 0, "max": 32, "default": 24 },
				{ "path": [ "mask6" ], "label": "IPv6 prefix length", "type": "integer", "min": 0, "max": 128, "default": 32 }
			]
		},
		"nftset": {
			"title": "NftSet",
			"description": "Edits the structured ipv4 and ipv6 targets. Compatibility-form fields remain in Advanced Mode.",
			"fields": [
				{ "path": [ "ipv4", "table_family" ], "label": "IPv4 table family", "type": "string", "placeholder": "ip" },
				{ "path": [ "ipv4", "table_name" ], "label": "IPv4 table name", "type": "string", "placeholder": "mangle" },
				{ "path": [ "ipv4", "set_name" ], "label": "IPv4 set name", "type": "string", "placeholder": "dns_v4" },
				{ "path": [ "ipv4", "mask" ], "label": "IPv4 prefix length", "type": "integer", "min": 0, "max": 32 },
				{ "path": [ "ipv6", "table_family" ], "label": "IPv6 table family", "type": "string", "placeholder": "ip6" },
				{ "path": [ "ipv6", "table_name" ], "label": "IPv6 table name", "type": "string", "placeholder": "mangle" },
				{ "path": [ "ipv6", "set_name" ], "label": "IPv6 set name", "type": "string", "placeholder": "dns_v6" },
				{ "path": [ "ipv6", "mask" ], "label": "IPv6 prefix length", "type": "integer", "min": 0, "max": 128 }
			]
		},
		"domain_set": {
			"title": "Domain Set",
			"fields": [
				{ "path": [ "exps" ], "label": "Inline domain expressions", "type": "string-list", "placeholder": "domain:example.com" },
				{ "path": [ "sets" ], "label": "Referenced domain sets", "type": "string-list" },
				{ "path": [ "files" ], "label": "Rule files", "type": "string-list", "placeholder": "/etc/oxidns/domain.txt" }
			]
		},
		"ip_set": {
			"title": "IP Set",
			"fields": [
				{ "path": [ "ips" ], "label": "Inline IP/CIDR rules", "type": "string-list", "placeholder": "192.0.2.0/24" },
				{ "path": [ "sets" ], "label": "Referenced IP sets", "type": "string-list" },
				{ "path": [ "files" ], "label": "Rule files", "type": "string-list", "placeholder": "/etc/oxidns/ip.txt" }
			]
		},
		"geosite": {
			"title": "GeoSite",
			"fields": [
				{ "path": [ "file" ], "label": "GeoSite data file", "type": "string", "placeholder": "/usr/share/oxidns/geosite.dat", "required": true },
				{ "path": [ "selectors" ], "label": "Selectors", "type": "string-list", "placeholder": "cn\ngeolocation-!cn" }
			]
		},
		"geoip": {
			"title": "GeoIP",
			"fields": [
				{ "path": [ "file" ], "label": "GeoIP data file", "type": "string", "placeholder": "/usr/share/oxidns/geoip.dat", "required": true },
				{ "path": [ "selectors" ], "label": "Selectors", "type": "string-list", "placeholder": "cn\nprivate" }
			]
		},
		"adguard_rule": {
			"title": "AdGuard Rule",
			"fields": [
				{ "path": [ "rules" ], "label": "AdGuard rules", "type": "string-list", "placeholder": "||example.com^" },
				{ "path": [ "files" ], "label": "Rule files", "type": "string-list", "placeholder": "/etc/oxidns/adguard.txt" }
			]
		},
		"dynamic_domain_set": {
			"title": "Dynamic Domain Set",
			"fields": [
				{ "path": [ "path" ], "label": "Rules file", "type": "string", "placeholder": "/tmp/oxidns/learned.txt", "required": true },
				{ "path": [ "bootstrap_rules" ], "label": "Bootstrap rules", "type": "string-list" },
				{ "path": [ "queue_size" ], "label": "Queue size", "type": "integer", "min": 1, "default": 1024 },
				{ "path": [ "batch_size" ], "label": "Batch size", "type": "integer", "min": 1, "default": 256 },
				{ "path": [ "flush_interval_ms" ], "label": "Flush interval (ms)", "type": "integer", "min": 1, "default": 200 }
			]
		},
		"tcp_server": {
			"title": "TCP Server",
			"fields": [
				{ "path": [ "cert" ], "label": "TLS certificate", "type": "string", "placeholder": "/etc/oxidns/server.crt" },
				{ "path": [ "key" ], "label": "TLS private key", "type": "string", "placeholder": "/etc/oxidns/server.key" },
				{ "path": [ "idle_timeout" ], "label": "Idle timeout", "type": "integer", "min": 0, "default": 10 }
			]
		},
		"http_server": {
			"title": "HTTP Server",
			"fields": [
				{
					"path": [ "entries" ],
					"label": "DoH entries",
					"type": "object-list",
					"item_label": "DoH entry",
					"required": true,
					"fields": [
						{ "path": [ "path" ], "label": "Request path", "type": "string", "required": true, "placeholder": "/dns-query" },
						{ "path": [ "exec" ], "label": "Entry executor", "type": "string", "required": true },
						{ "path": [ "json_api" ], "label": "Enable JSON DNS API", "type": "boolean", "default": false }
					]
				},
				{ "path": [ "listen" ], "label": "HTTP listen", "type": "string", "placeholder": ":443" },
				{ "path": [ "src_ip_header" ], "label": "Client IP header", "type": "string", "placeholder": "X-Real-IP" },
				{ "path": [ "cert" ], "label": "TLS certificate", "type": "string", "placeholder": "/etc/oxidns/server.crt" },
				{ "path": [ "key" ], "label": "TLS private key", "type": "string", "placeholder": "/etc/oxidns/server.key" },
				{ "path": [ "idle_timeout" ], "label": "Idle timeout", "type": "integer", "min": 0, "default": 30 },
				{ "path": [ "enable_http3" ], "label": "Enable HTTP/3", "type": "boolean" }
			]
		},
		"quic_server": {
			"title": "QUIC Server",
			"fields": [
				{ "path": [ "cert" ], "label": "TLS certificate", "type": "string", "placeholder": "/etc/oxidns/server.crt", "required": true },
				{ "path": [ "key" ], "label": "TLS private key", "type": "string", "placeholder": "/etc/oxidns/server.key", "required": true },
				{ "path": [ "idle_timeout" ], "label": "Idle timeout", "type": "integer", "min": 0 }
			]
		}
	}
}
